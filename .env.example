# 企业桌面部署示例；REPLACE_* 值仅作占位，部署时替换为真实凭证。
QO_DEMO=0
QO_TIMEZONE=Asia/Shanghai
QO_PUBLIC_ORIGIN=https://office.aethernettech.dev

# 造场 OIDC：应用在 https://aetherstudio.top/developers 登记。
QO_OIDC_ISSUER=https://aetherstudio.top
QO_OIDC_CLIENT_ID=qiongyu-office
QO_OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET

# sub2api 企业按人开通。密钥应仅授予 users.provision.write，并使用 adm_sc_ 前缀。
# 配置这两个变量后，部署前运行：python scripts/check_sub2api_key.py（只读权限探测）。
QO_SUB2API_URL=https://aethernettech.dev
QO_SUB2API_PROVISION_KEY=adm_sc_REPLACE_WITH_RESTRICTED_KEY
QO_SUB2API_DEFAULT_GROUP_ID=1
QO_SUB2API_KEY_NAME=qiongyu-office

# 桌面客户端在本机执行 Harness；服务端不需要模型网关凭证。
QO_ENGINE=desktop
# QO_GATEWAY_BASE_URL=https://model-gateway.example.com/v1
# QO_GATEWAY_KEY=REPLACE_WITH_GATEWAY_KEY
# QO_GATEWAY_MODEL=replace-with-model-id
# QO_GATEWAY_* 仅在 QO_ENGINE=gateway 或 QO_ENGINE=dsh 时需要。

# 桌面端智能分工；模型 ID 必须与员工实时 /v1/models 返回值完全一致。
QO_PIPELINE_ENABLED=1
# 可选覆盖角色模型；缺省值见 README 的“桌面智能分工”。
# QO_PIPELINE_MODEL_UNDERSTAND=glm-5.3
# QO_PIPELINE_MODEL_EXECUTE=step-5-preview
# QO_PIPELINE_MODEL_ACCEPT=glm-5.3
# QO_PIPELINE_MODEL_REVIEW=k3.1-pro
# QO_PIPELINE_MODEL_LIGHT=deepseek-v4.1-flash-1017

# 开放注册只接受 0/1，缺省为 0；生产开放时设为 1，造场会员即可登录。
# 新用户默认 employee，sub2api 余额为 0；管理员需分配余额/订阅/额度后才能对话。
QO_OPEN_ENROLLMENT=0
# Compose 会将 users.json 挂载到此路径；名单项可设置 "enabled": false 以拒绝登录并清理会话。
QO_USERS_FILE=/config/users.json
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
QO_CLAMD=

# 仅服务端 QO_ENGINE=dsh 使用；desktop 模式的 Harness 固定使用安装包运行时。
# QO_DSH_PLUGIN_PATCH=
# QO_DSH_PLUGIN_TOOLS=
