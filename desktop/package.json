{
  "name": "qiongyu-office-desktop",
  "version": "0.2.0",
  "description": "Qiongyu Office employee desktop",
  "author": "Qiongyu Technology",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "node scripts/prepare-runtime.mjs && electron-builder --win --x64 && node scripts/check-no-dsh-conflict.mjs",
    "build:linux": "electron-builder --linux dir --x64"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.qiongyutech.office",
    "productName": "穹驭办公",
    "artifactName": "QiongyuOffice-${version}-${arch}.${ext}",
    "files": [
      "main.cjs",
      "agent.cjs",
      "lib/**",
      "preload.cjs",
      "package.json",
      "connect.html"
    ],
    "extraResources": [
      {
        "from": "runtime-stage/qo-runtime",
        "to": "qo-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "office.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "include": "uninstaller.nsh"
    }
  }
}
