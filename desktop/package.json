{
  "name": "qiongyu-office-desktop",
  "version": "0.2.11",
  "description": "Qiongyu Office employee desktop",
  "author": "Qiongyu Technology",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "node scripts/prepare-runtime.mjs && electron-builder --win --x64 && node scripts/check-no-dsh-conflict.mjs && node scripts/build-delta.mjs",
    "build:delta": "electron-builder --win --x64 --dir && node scripts/build-delta.mjs",
    "build:linux": "electron-builder --linux dir --x64"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.qiongyutech.office",
    "productName": "穹驭办公",
    "artifactName": "QiongyuOffice-${version}-${arch}.${ext}",
    "files": [
      "main.cjs",
      "agent.cjs",
      "lib/**",
      "preload.cjs",
      "package.json",
      "connect.html",
      "office.ico"
    ],
    "extraResources": [
      {
        "from": "runtime-stage/qo-runtime.7z",
        "to": "qo-runtime.7z"
      }
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true,
      "icon": "office.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "include": "installer.nsh",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "multiLanguageInstaller": true,
      "displayLanguageSelector": false,
      "installerSidebar": "installerSidebar.bmp",
      "uninstallerSidebar": "installerSidebar.bmp",
      "installerHeader": "installerHeader.bmp",
      "shortcutName": "穹驭办公",
      "preCompressedFileExtensions": [
        ".avi",
        ".mov",
        ".m4v",
        ".mp4",
        ".m4p",
        ".qt",
        ".mkv",
        ".webm",
        ".vmdk",
        ".7z"
      ]
    }
  }
}
